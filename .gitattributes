# The built-in lane files are compiled into the binary via go:embed, and the
# lane tests patch their raw bytes with \n-anchored replacements. A Windows
# checkout with core.autocrlf would hand go:embed CRLF bytes, which is how CI
# failed on windows-latest only — so their line endings are pinned here rather
# than left to the client's autocrlf setting.
core/lane/builtin/*.md text eol=lf

# Same for the role prompts: core/role/builtin is embedded the same way, the
# role tests match "\nname: <id>\n" against the raw bytes, and a CRLF checkout
# would also ship prompts with CRLF to whoever builds on Windows. The shipped
# shell script is pinned for the older reason: CRLF makes it unrunnable.
core/role/builtin/**/*.md text eol=lf
core/role/builtin/**/*.sh text eol=lf
# The acceptance role's builder and page templates: python3 reads build.py
# either way, but the pages it writes would carry CRLF into every artifact.
core/role/builtin/**/*.py text eol=lf
core/role/builtin/**/*.html text eol=lf

# The mods: core/mod/builtin is embedded and installed the same way. A CRLF
# checkout would ship a manifest, a hooks module and a state contract with
# \r in them to whoever builds on Windows. Every file there is text,
# including what Claude Code generates into a mod folder it loads.
core/mod/builtin/** text eol=lf

# core/release/NOTES.md and the notes under core/release/notes are embedded
# and read back line by line — a CRLF checkout turns every entry into one that
# ends in \r. The notes pattern takes ** because a release moves its notes into
# notes/<version>/, a folder that does not exist until the release button runs.
# core/hook/example is the shipped notify hook: CRLF makes it unrunnable, the
# same reason the role scripts above are pinned.
core/release/NOTES.md text eol=lf
core/release/notes/**/*.md text eol=lf
core/hook/example/*.sh text eol=lf

# The page 'jaira web' serves: core/web/ui/dist is embedded, and CI diffs it
# against a fresh build of the sources beside it. A CRLF checkout would embed
# \r into the page and make that diff fail on a tree nobody changed, so the
# whole front end — sources, lock file and build — is pinned.
core/web/ui/** text eol=lf

# The list of every shipped version of every installed file is embedded and
# compared by hash; the fixtures the tests hold against it are older versions of
# those files. A CRLF checkout changes every hash.
core/shipped/shipped.sha256 text eol=lf
core/role/testdata/** text eol=lf
core/lane/testdata/** text eol=lf
